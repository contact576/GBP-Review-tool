# Foundly — all env vars are OPTIONAL. The app builds and runs with none set
# (ephemeral in-memory "Demo mode"). Add these to unlock real capabilities.

# --- Live AI generation (optional) ---
# When set, /api/ai/* uses Anthropic. Without it, high-quality templates are used.
# ANTHROPIC_API_KEY=sk-ant-...
# Default model is a cheap, fast Haiku-class model. Override if desired.
# FOUNDLY_AI_MODEL=claude-haiku-4-5-20251001

# --- Real persistence (optional) ---
# When set, data is stored in Postgres via Drizzle (Neon/Supabase/any Postgres).
# Without it, the app uses seeded in-memory demo data.
# Get a free Postgres URL at https://neon.tech, then run:
#   npm run db:push && npm run db:seed
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- App URL (optional) ---
# Public origin used for absolute URLs (OAuth redirects, QR codes, emails).
# Unset, the app falls back to the current request's host.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets (recommended in production) ---
# Signs session JWTs. Unset, a dev fallback is used (sessions reset on change).
# AUTH_SECRET=generate-with: openssl rand -base64 32
# Encrypts stored Google refresh tokens (AES-256-GCM). Falls back to AUTH_SECRET.
# ENCRYPTION_SECRET=generate-with: openssl rand -base64 32

# --- Google sign-in + Business Profile connect (optional) ---
# OAuth 2.0 Web client from Google Cloud console → APIs & Services → Credentials.
# Register BOTH redirect URIs on the client, for your app URL AND localhost:
#   {NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#   {NEXT_PUBLIC_APP_URL}/api/google/connect/callback
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/google/connect/callback
# Without these, Google sign-in/connect buttons show honest "not configured" states.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...

# --- Google Places lookup (optional) ---
# API key with "Places API (New)" enabled — powers real business search in
# onboarding and the free score tool. Without it, both degrade honestly.
# GOOGLE_MAPS_API_KEY=AIza...
