# Foundly runs in an honest in-memory preview with no variables. Production
# should configure persistence, secrets, and the providers it intends to sell.

# Public application origin (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Server-only fallback accepted by app-url.ts
# APP_URL=http://localhost:3000

# Production security (independent random values, at least 32 bytes each)
# AUTH_SECRET=
# ENCRYPTION_SECRET=
# HEALTH_CHECK_SECRET=
# CONTENT_ASSET_SIGNING_SECRET=
# CRON_SECRET=

# Postgres over the standard wire protocol — Supabase, Neon, RDS, or self-hosted.
# Supabase: Project Settings -> Database -> Connection string -> "Transaction"
#   (port 6543). Prepared statements are disabled automatically for transaction-
#   mode poolers; a direct 5432 connection keeps them enabled.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Verify the whole database path (schema + a real account round trip):
#   npm run db:verify

# Daily continuous monitoring (call GET /api/cron/monitor with
# Authorization: Bearer $CRON_SECRET; repeat hourly to drain large batches)
# MONITORING_BATCH_SIZE=15

# Anthropic AI (templates remain available when unset)
# ANTHROPIC_API_KEY=sk-ant-...
# FOUNDLY_AI_MODEL=claude-haiku-4-5-20251001

# OpenAI content studio (API billing is separate from ChatGPT subscriptions)
# OPENAI_API_KEY=sk-proj-...
# FOUNDLY_OPENAI_TEXT_MODEL=gpt-5.4-mini
# FOUNDLY_OPENAI_IMAGE_MODEL=gpt-image-2

# AI Visibility engines (each is asked the same questions; unset = reported as
# "not connected", never as a miss). Claude reuses ANTHROPIC_API_KEY, ChatGPT
# reuses OPENAI_API_KEY. Per-engine model overrides are optional.
# GOOGLE_AI_API_KEY=AIza...
# PERPLEXITY_API_KEY=pplx-...
# FOUNDLY_AEO_OPENAI_MODEL=gpt-5.4-mini
# FOUNDLY_AEO_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# FOUNDLY_AEO_GEMINI_MODEL=gemini-2.0-flash
# FOUNDLY_AEO_PERPLEXITY_MODEL=sonar

# Google OAuth / Business Profile
# Redirects:
#   {APP_URL}/api/auth/google/callback
#   {APP_URL}/api/google/connect/callback
#   {APP_URL}/api/google/gmail/connect/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Gmail send (Settings → Channels → "Connect Gmail"): a workspace sends its
# review requests / invites / reports through the Gmail API from the owner's
# own mailbox, using the same OAuth client above. For the Cloud project:
#   1. APIs & Services → Library → enable "Gmail API".
#   2. OAuth consent screen → Scopes → add
#      https://www.googleapis.com/auth/gmail.send  (a "sensitive" scope:
#      unverified apps are capped at 100 users and show a warning screen;
#      submit for verification before going wide).
#   3. Credentials → the OAuth client → add the redirect URI
#      {APP_URL}/api/google/gmail/connect/callback
# Refresh tokens are stored AES-256-GCM encrypted (ENCRYPTION_SECRET) in
# email_credential, one per workspace. No extra env var is needed.

# Google Places API (New): onboarding, public score, and rank-grid scans
# GOOGLE_MAPS_API_KEY=

# Apify: full Google review history WITHOUT Business Profile API approval.
#
# GBP API access is granted per Cloud project and can take weeks. Until it
# lands, the owned sync 403s and the app falls back to the Places sample, which
# is at most 5 reviews. With this token set, the sync instead imports the full
# history from public Google data, carrying Google's own review ids so the
# records collapse onto the approved sync later without losing history.
#
# It reads only. Owner replies, posts and profile edits still require GBP
# OAuth, and the owner-only surfaces (Performance metrics, search keywords,
# Google's pending edits) stay recorded as not-authorised, never as zero.
#
# Token: https://console.apify.com/settings/integrations
# APIFY_TOKEN=

# Email: review requests, staff invites, password resets, agency reports.
#
# These are the DEPLOYMENT-WIDE fallback sender. Each workspace can override it
# from Settings → Channels (stored encrypted per workspace), so these are only
# needed for pre-auth mail — password resets and sign-up verification — and as
# the default for workspaces that haven't connected their own.
#
# Option A — Resend (hosted API, best deliverability):
# RESEND_API_KEY=re_...
# EMAIL_FROM=Foundly <reviews@your-domain.com>
#
# Option B — any SMTP mailbox you already own (no API account needed).
# Gmail/Workspace: smtp.gmail.com:587 with a 16-char App Password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=reviews@your-domain.com
# SMTP_PASSWORD=
# SMTP_SECURE=false          # true only for implicit-TLS port 465
# EMAIL_FROM=Foundly <reviews@your-domain.com>

# Twilio: use a Messaging Service SID when possible; otherwise an E.164 sender
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=MG...
# TWILIO_FROM_NUMBER=+14155550123
# Configure both inbound and status webhooks against your deployed origin:
#   POST {APP_URL}/api/webhooks/twilio/inbound
#   Status callbacks are supplied automatically per message.

# Stripe lifecycle
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook endpoint: POST {APP_URL}/api/webhooks/stripe
# Subscribe to checkout.session.completed and customer.subscription.created,
# updated, deleted, paused, and resumed.
# STRIPE_PRICE_STARTER_MONTHLY=price_...
# STRIPE_PRICE_STARTER_ANNUAL=price_...
# STRIPE_PRICE_GROWTH_MONTHLY=price_...
# STRIPE_PRICE_GROWTH_ANNUAL=price_...
# STRIPE_PRICE_MULTI_MONTHLY=price_...
# STRIPE_PRICE_MULTI_ANNUAL=price_...
# STRIPE_PRICE_AGENCY_MONTHLY=price_...
# STRIPE_PRICE_AGENCY_ANNUAL=price_...
# Referral credit in the smallest currency unit; defaults to 5000 ($50)
# REFERRAL_CREDIT_CENTS=5000

# ── Rate limiting (Upstash Redis, optional) ──────────────────
# Without BOTH of these, rate limiting counts per serverless instance only —
# which on Vercel means limits are NOT enforced across the fleet. The app logs
# this once per instance rather than pretending it is protected. Set both to
# get real distributed enforcement on the AI, free-score and review endpoints.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
